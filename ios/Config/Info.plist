<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- What every build adds to the generated Info.plist (P5D.5): the launch screen is
	     the lobby's night, the first screen without its content, as Apple asks. The colour
	     is the asset catalog's Night, which `pnpm art` writes from theme.css.
	     Config/Debug-Info.plist repeats it for debug builds. -->
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>Night</string>
	</dict>
</dict>
</plist>
