# rivermindpoker.com: installed as /etc/caddy/sites/rivermindpoker.com.caddy by
# deploy/update.sh and loaded by the host Caddyfile (`import /etc/caddy/sites/*.caddy`).
# DNS for both names points at the host, so Caddy obtains and renews certificates.
# Pages and assets come from the SvelteKit Node server, rivermind-poker-web.service
# on 127.0.0.1:4320, which sets their Cache-Control (a year for the hashed files
# under /_app/immutable/, revalidate for everything else) and a CSP carrying the
# hash of SvelteKit's start-up script. Until the P4B.7 cutover, /api/* and the
# /ws WebSocket go straight to the Python table server, rivermind-poker.service
# on 127.0.0.1:4316.
#
# Check and reload: caddy validate --config /etc/caddy/Caddyfile && systemctl reload caddy

www.rivermindpoker.com {
	redir https://rivermindpoker.com{uri} permanent
}

rivermindpoker.com {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		# The client is same-origin files plus one WebSocket, with no inline code but
		# the start-up script whose hash the pages' own policy names. `?` keeps that
		# policy and gives every other response (the API, errors) this one.
		?Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self'; script-src 'self'; connect-src 'self' wss://rivermindpoker.com; object-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
		-Server
	}

	request_body {
		max_size 16KB
	}

	# New players (made by POST /api/session on a first visit), tables and
	# practice tables (P6.0b) are cheap but stored; slow down scripted creation.
	rate_limit {
		zone new_tables {
			match {
				method POST
				path /api/tables /api/session /api/practice
			}
			key {remote_host}
			events 30
			window 1m
		}
		# The lobby (P4.3): quick seat can start a table; seats and the
		# waitlist change tables other people are at.
		zone seating {
			match {
				method POST DELETE
				path /api/quick-seat /api/tables/*
			}
			key {remote_host}
			events 60
			window 1m
		}
		# Reports, mutes and blocks (P4.5); the app also limits reports per player.
		zone safety {
			match {
				method POST PUT DELETE
				path /api/reports /api/relations /api/relations/*
			}
			key {remote_host}
			events 30
			window 1m
		}
	}

	handle /api/* {
		reverse_proxy 127.0.0.1:4316
	}

	handle /ws {
		reverse_proxy 127.0.0.1:4316 {
			# A config reload would otherwise close every open game socket.
			stream_close_delay 5m
		}
	}

	handle {
		reverse_proxy 127.0.0.1:4320
	}

	handle_errors 502 503 504 {
		header Content-Type "text/plain; charset=utf-8"
		header Cache-Control "no-store"
		respond "RiverMind Poker is restarting. Try again in a minute." 503
	}

	log {
		output file /var/log/caddy/rivermindpoker-access.log {
			roll_size 10MiB
			roll_keep 7
			roll_keep_for 168h
		}
	}
}
