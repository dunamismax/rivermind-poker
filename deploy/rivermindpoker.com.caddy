# rivermindpoker.com: installed as /etc/caddy/sites/rivermindpoker.com.caddy by
# deploy/update.sh and loaded by the host Caddyfile (`import /etc/caddy/sites/*.caddy`).
# DNS for both names points at the host, so Caddy obtains and renews certificates.
# Everything comes from the Node server, rivermind-poker-web.service on
# 127.0.0.1:4320: pages and assets, the API and the tables' /ws WebSocket
# (P4B.7). It sets the pages' Cache-Control (a year for the hashed files under
# /_app/immutable/, revalidate for everything else) and a CSP carrying the hash
# of SvelteKit's start-up script; Caddy adds its policy only to the API, the
# socket handshake and its own error page.
#
# Check: caddy-apply --check rivermindpoker.com deploy/rivermindpoker.com.caddy
# Install and reload only through caddy-apply, inside with-deploy-lock (update.sh step 7).

www.rivermindpoker.com {
	redir https://rivermindpoker.com{uri} permanent
}

rivermindpoker.com {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}

	request_body {
		max_size 16KB
	}

	# New players (made by POST /api/session on a first visit), tables and
	# practice tables (P6.0b) are cheap but stored; slow down scripted creation.
	rate_limit {
		zone new_tables {
			match {
				method POST
				path /api/tables /api/session /api/practice
			}
			key {remote_host}
			events 30
			window 1m
		}
		# The lobby (P4.3): quick seat can start a table; seats and the
		# waitlist change tables other people are at.
		zone seating {
			match {
				method POST DELETE
				path /api/quick-seat /api/tables/*
			}
			key {remote_host}
			events 60
			window 1m
		}
		# Reports, mutes and blocks (P4.5); the app also limits reports per player.
		zone safety {
			match {
				method POST PUT DELETE
				path /api/reports /api/relations /api/relations/*
			}
			key {remote_host}
			events 30
			window 1m
		}
		# Table voice (P4C.8): a voice token, and the voice socket's handshake once
		# P4C.9 routes /voice. Each token opens one connection; the app limits them
		# per player and per address, and the voice service its sockets per address
		# and what each player sends.
		zone voice {
			match {
				path /api/tables/*/voice /voice
			}
			key {remote_host}
			events 30
			window 1m
		}
	}

	# The Node server sends each page's policy itself, with the hash of SvelteKit's
	# start-up script, and leaves it off a 304, so the browser keeps the cached
	# page's. Caddy must not add a policy to a page or an asset: Chromium applies
	# a 304's headers to the cached page, and this stricter policy would block the
	# start-up script on every reload. The API's answers, the socket handshake and
	# Caddy's own error page get it.
	handle /api/* {
		header Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self'; script-src 'self'; connect-src 'self' wss://rivermindpoker.com; object-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
		reverse_proxy 127.0.0.1:4320
	}

	handle /ws {
		header Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self'; script-src 'self'; connect-src 'self' wss://rivermindpoker.com; object-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
		reverse_proxy 127.0.0.1:4320 {
			# A config reload would otherwise close every open game socket.
			stream_close_delay 5m
		}
	}

	handle {
		reverse_proxy 127.0.0.1:4320
	}

	handle_errors 502 503 504 {
		header Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self'; script-src 'self'; connect-src 'self' wss://rivermindpoker.com; object-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
		header Content-Type "text/plain; charset=utf-8"
		header Cache-Control "no-store"
		respond "RiverMind Poker is restarting. Try again in a minute." 503
	}

	log {
		output file /var/log/caddy/rivermindpoker-access.log {
			roll_size 10MiB
			roll_keep 7
			roll_keep_for 168h
		}
	}
}
