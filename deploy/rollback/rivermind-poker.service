# ROLLBACK ONLY (until P4B.8): the Python no-limit table server, serve-nl, which
# ran the tables before the P4B.7 cutover. deploy/update.sh installs it as
# /etc/systemd/system/rivermind-poker.service but leaves it stopped and
# disabled; deploy/rollback-to-serve-nl.sh starts it. It must never run beside
# a Node server that has the tables (RIVERMIND_API=1): both would restore and
# deal the same tables. The live web unit names it in Conflicts= for that reason.
# It serves the git checkout in /home/sawyer/github/rivermind-poker on loopback
# as the rivermind-poker user, with DATABASE_URL from web.env and the session
# secret in its private state directory, which the web unit reads as a credential.
[Unit]
Description=RiverMind Poker browser table (rivermindpoker.com)
Documentation=https://github.com/dunamismax/rivermind-poker
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=simple
User=rivermind-poker
Group=rivermind-poker
WorkingDirectory=/home/sawyer/github/rivermind-poker
Environment=PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1
# DATABASE_URL for the rivermind_poker_web role, from deploy/setup-database.sh.
EnvironmentFile=/etc/rivermind-poker/web.env
StateDirectory=rivermind-poker
StateDirectoryMode=0700
ExecStart=/home/sawyer/github/rivermind-poker/.venv/bin/rivermind-poker serve-nl \
    --host 127.0.0.1 --port 4316 \
    --secret_file /var/lib/rivermind-poker/secret
Restart=on-failure
RestartSec=5
TimeoutStopSec=15
SyslogIdentifier=rivermind-poker

UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
MemoryHigh=2G
MemoryMax=3G
TasksMax=128

[Install]
WantedBy=multi-user.target
