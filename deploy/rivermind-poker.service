# RiverMind Poker no-limit table server: installed as
# /etc/systemd/system/rivermind-poker.service by deploy/update.sh.
# Serves the git checkout in /home/sawyer/github/rivermind-poker on loopback;
# Caddy proxies https://rivermindpoker.com/api and /ws to it
# (deploy/rivermindpoker.com.caddy). The dedicated rivermind-poker user only
# needs traverse access to /home/sawyer (ACL) and read access to the checkout,
# its .venv and the Python under /opt/uv-python.
# Every table is saved to PostgreSQL (DATABASE_URL in web.env) after each
# change and restored on start, so restarts and deploys keep every game. The
# secret that signs player tokens lives in the private state directory, so
# players keep their identity across restarts too.
[Unit]
Description=RiverMind Poker browser table (rivermindpoker.com)
Documentation=https://github.com/dunamismax/rivermind-poker
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=simple
User=rivermind-poker
Group=rivermind-poker
WorkingDirectory=/home/sawyer/github/rivermind-poker
Environment=PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1
# DATABASE_URL for the rivermind_poker_web role, from deploy/setup-database.sh.
EnvironmentFile=/etc/rivermind-poker/web.env
StateDirectory=rivermind-poker
StateDirectoryMode=0700
ExecStart=/home/sawyer/github/rivermind-poker/.venv/bin/rivermind-poker serve-nl \
    --host 127.0.0.1 --port 4316 \
    --secret_file /var/lib/rivermind-poker/secret
Restart=on-failure
RestartSec=5
TimeoutStopSec=15
SyslogIdentifier=rivermind-poker

UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
MemoryHigh=2G
MemoryMax=3G
TasksMax=128

[Install]
WantedBy=multi-user.target
