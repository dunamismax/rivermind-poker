#!/usr/sbin/nft -f
# RiverMind Poker table voice: a cap on TCP connections to the media port
# (3478) from one address (P4C.8's review, sized at P4C.7, launched at P4C.9).
#
# mediasoup's worker answers ICE only for a transport's own credentials, but it
# keeps a TCP connection that never sends a byte open, and the voice service
# cannot close it. Without a cap one address could hold as many as it liked.
# A person in voice has two transports, most of them on UDP, and a household
# or an office shares an address: 32 leaves room for a full table behind one.
# IPv6 is counted by /64, which is one network. UDP is not counted: it holds no
# connection, and the worker drops what is not ICE for a transport it knows.
#
# The table is this site's own, apart from ufw's (which allows the port) and
# from every other table on the host: a refusal here is final, and anything it
# passes still goes through ufw. Loading the file replaces the table whole and
# touches nothing else. The voice unit loads it before it starts
# (ExecStartPre=+), so it is there after a reboot, and deploy/update.sh loads
# it when it changed.
#
# Check:  nft -c -f deploy/voice-firewall.nft
# See:    nft list table inet rivermind_voice   (the counters are refusals)
# Remove: nft delete table inet rivermind_voice

table inet rivermind_voice
delete table inet rivermind_voice

table inet rivermind_voice {
	# One element an address while it holds a connection; the kernel drops an
	# element whose count is back to none.
	set tcp4 {
		type ipv4_addr
		size 65536
		flags dynamic
	}

	set tcp6 {
		type ipv6_addr
		size 65536
		flags dynamic
	}

	chain input {
		type filter hook input priority filter - 10; policy accept;
		tcp dport 3478 ct state new add @tcp4 { ip saddr ct count over 32 } counter reject with tcp reset
		tcp dport 3478 ct state new add @tcp6 { ip6 saddr and ffff:ffff:ffff:ffff:: ct count over 32 } counter reject with tcp reset
	}
}
