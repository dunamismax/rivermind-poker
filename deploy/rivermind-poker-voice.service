# RiverMind Poker table voice (P4C.4, D-15): installed as
# /etc/systemd/system/rivermind-poker-voice.service by deploy/update.sh.
# Runs build/voice/voice.js of the current release, with mediasoup's worker
# binary beside it (web/vite.voice.config.ts), on the host's pinned Node 26.
# It relays each table's encrypted audio and carries its MLS group, holds no
# key that could open a frame, and keeps its rooms in memory only
# (docs/voice.md).
#
# It is a unit of its own, apart from rivermind-poker-web, for two reasons.
# It is the one RiverMind process that listens beyond loopback: media arrive
# on UDP and TCP 3478 from the internet (Q-9), an exception to the host's web
# platform contract, which D-15 makes. And conversations outlast site deploys:
# update.sh restarts this unit only when build/voice/ or this file changed.
# Signalling listens on loopback only, on 127.0.0.1:4323, where Caddy carries
# wss://rivermindpoker.com/voice (since P4C.9).
#
# update.sh starts a copy of this file as rivermind-poker-voice-candidate
# before every deploy: it rewrites the release path, PORT, VOICE_MEDIA_PORT and
# the SocketBindAllow= lines to free candidate ports, and VOICE_LISTEN_IPS to
# loopback, and leaves out the ExecStartPre= line, so a candidate never touches
# the live port's firewall table. Keep HOST and PORT on one Environment= line,
# the media settings on another, the firewall on one ExecStartPre= line, and
# name the release only as /srv/rivermindpoker.com/current.
[Unit]
Description=RiverMind Poker table voice (rivermindpoker.com)
Documentation=https://github.com/dunamismax/rivermind-poker
After=network-online.target
Wants=network-online.target
ConditionPathExists=/srv/rivermindpoker.com/current/build/voice/voice.js
StartLimitIntervalSec=300
StartLimitBurst=20

[Service]
Type=simple
DynamicUser=yes
User=rivermind-poker-voice
Group=rivermind-poker-voice
WorkingDirectory=/srv/rivermindpoker.com/current
# The cap on TCP connections to the media port from one address
# (deploy/voice-firewall.nft): loaded as root before the service starts, so it
# is there after a reboot. The `+` lifts this unit's sandbox for that one
# command; the service itself runs with none of root's powers.
ExecStartPre=+/usr/sbin/nft -f /srv/rivermindpoker.com/current/deploy/voice-firewall.nft
ExecStart=/opt/node-26/bin/node /srv/rivermindpoker.com/current/build/voice/voice.js
Environment=NODE_ENV=production HOST=127.0.0.1 PORT=4323
Environment=VOICE_ORIGINS=https://rivermindpoker.com
# Media on every address of the VM, announced as the router's public address,
# which the site's own name points at (src/lib/server/voice/address.ts looks it
# up again every minute). The router and the Windows host forward 3478 here (Q-9).
Environment=VOICE_MEDIA_PORT=3478 VOICE_LISTEN_IPS=0.0.0.0
Environment=VOICE_ANNOUNCED_HOST=rivermindpoker.com
# How much voice the host carries at once (P4C.7, docs/voice.md): at either
# limit a table is told voice is full. Measured here with `pnpm voice:load`:
# eight full tables with everyone talking take 45% of the media worker's one
# core and 118 MB, under MemoryHigh below, and send 59 Mbps of the 385 the host
# uploads. Raise the limit and MemoryHigh together.
Environment=VOICE_MAX_ROOMS=8 VOICE_MAX_PEOPLE=72
# The voice key, derived from the site's secret by update.sh
# (`voice.js derive-key`): tokens from the web service verify under it, and
# nothing here can sign a session cookie. Root-only where it is; systemd hands
# this service a read-only copy.
LoadCredential=voice-key:/var/lib/rivermind-poker/voice-key
Environment=VOICE_KEY_FILE=%d/voice-key
# A media worker that dies is replaced inside the service (P4C.7). If none can
# be started, the service stops, and it starts again here.
Restart=always
RestartSec=3
TimeoutStopSec=10
SyslogIdentifier=rivermind-poker-voice

UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
# No MemoryDenyWriteExecute: V8's JIT needs writable, executable pages.
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
# Beyond the web unit's sandbox (P4C.8's review, tried at P4C.9 with calls from
# three browsers over UDP and TCP and a media worker killed and replaced): only
# the system calls a service needs, no view of other processes or of /proc
# beyond its own, and a user namespace in which it is nobody on the host.
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
ProtectProc=invisible
ProcSubset=pid
PrivateUsers=yes
# Binds its signalling port and the media port, and nothing else.
SocketBindAllow=tcp:4323
SocketBindAllow=udp:3478
SocketBindAllow=tcp:3478
SocketBindDeny=any
# The platform's defaults. P4C.1 measured 75 to 100 MB for the Node side, and
# P4C.7 about 14 MB a room in the worker with all nine talking (118 MB for the
# eight rooms VOICE_MAX_ROOMS allows).
MemoryHigh=256M
MemoryMax=512M
TasksMax=64

[Install]
WantedBy=multi-user.target
