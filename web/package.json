{
	"name": "rivermind-poker-web",
	"version": "0.1.0",
	"description": "Browser client for RiverMind Poker",
	"license": "GPL-3.0-or-later",
	"private": true,
	"type": "module",
	"engines": {
		"node": "26.13.1"
	},
	"packageManager": "pnpm@12.18.0",
	"imports": {
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build && vite build --config vite.server.config.ts && vite build --config vite.voice.config.ts && node scripts/check-inline-code.js && node scripts/voice-files.js",
		"start": "node build/start.js",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test": "vitest --run",
		"test:watch": "vitest",
		"e2e": "playwright test",
		"e2e:live": "playwright test --config playwright.live.config.ts",
		"visual": "playwright test --config playwright.visual.config.ts",
		"visual:compare": "node scripts/visual-compare.ts",
		"voice:check": "playwright test --config playwright.voice-check.config.ts",
		"voice:load": "node scripts/voice-load.ts",
		"voice:measure": "playwright test --config playwright.voice-measure.config.ts",
		"voice:proto": "playwright test --config playwright.voice.config.ts",
		"protocol": "cd .. && uv run --locked rivermind-poker protocol-schema --typescript web/src/lib/protocol.ts",
		"protocol:swift": "node scripts/protocol-swift.ts",
		"ios:fixtures": "IOS_FIXTURES=write vitest --run src/lib/server/api/ios-fixtures.spec.ts src/lib/server/api/ios-display.spec.ts src/lib/server/api/ios-session.spec.ts",
		"art": "node scripts/generate-art.js",
		"engine:parity": "node scripts/engine-parity.ts",
		"engine:bench": "node scripts/engine-bench.ts",
		"bots:parity": "node scripts/bots-parity.ts",
		"table:parity": "node scripts/table-parity.ts",
		"bots:bench": "node scripts/bots-bench.ts",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "node scripts/db-migrate.ts",
		"moderation": "node scripts/moderation.ts"
	},
	"devDependencies": {
		"@eslint/js": "10.0.1",
		"@playwright/test": "1.65.1",
		"@sapphi-red/web-noise-suppressor": "0.4.1",
		"@sveltejs/adapter-node": "6.0.5",
		"@sveltejs/kit": "3.4.0",
		"@sveltejs/vite-plugin-svelte": "7.3.1",
		"@tailwindcss/vite": "4.3.5",
		"@types/node": "26.6.6",
		"@types/pg": "8.23.1",
		"@types/ws": "8.18.1",
		"drizzle-kit": "0.31.11",
		"drizzle-orm": "0.45.4",
		"eslint": "10.15.0",
		"eslint-config-prettier": "10.1.8",
		"eslint-plugin-svelte": "3.24.1",
		"globals": "17.14.0",
		"mediasoup": "3.32.2",
		"mediasoup-client": "3.26.0",
		"pg": "8.23.1",
		"prettier": "3.10.1",
		"prettier-plugin-svelte": "4.2.0",
		"svelte": "5.58.1",
		"svelte-check": "4.7.8",
		"tailwindcss": "4.3.5",
		"ts-mls": "1.6.4",
		"typescript": "6.0.3",
		"typescript-eslint": "8.73.0",
		"vite": "8.3.8",
		"vitest": "5.1.1",
		"ws": "8.23.0"
	}
}
